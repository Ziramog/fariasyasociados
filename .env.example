# Farias & Asociados — environment template. No cargar secretos reales acá.

# Base app / dominio
NEXT_PUBLIC_DOMAIN=https://farias-asociados.vercel.app
NEXTAUTH_URL=https://farias-asociados.vercel.app
NEXTAUTH_SECRET=

# Contacto público
NEXT_PUBLIC_WHATSAPP_NUMBER=5490000000000
NEXT_PUBLIC_CONTACT_PHONE=+54 9 0000 000000
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=Teléfono pendiente

# MongoDB — usar DB/cluster propio de Farias, nunca Roggero
MONGODB_URI=

# Cloudinary — usar cloud/preset/folder propios de Farias
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_CLOUDINARY_FOLDER=farias/properties
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth Google — OAuth client propio para dominio Farias
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Maps / Google Places
NEXT_PUBLIC_MAP_PROVIDER=mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_API_KEY=
GOOGLE_PLACE_ID=

# Vercel Blob / PDFs / logos
BLOB_READ_WRITE_TOKEN=
BLOB_PREFIX=farias

# Cron reviews
CRON_SECRET=

# IA descripción/propuestas
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
